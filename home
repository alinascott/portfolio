                <button onclick="switchPage('home')" class="hover:text-stone-900 dark:hover:text-stone-100 transition">Home</button>
                <button onclick="switchPage('timeline')" class="hover:text-stone-900 dark:hover:text-stone-100 transition">Timeline</button>
                <button onclick="switchPage('archive')" class="hover:text-stone-900 dark:hover:text-stone-100 transition">Archive</button>
